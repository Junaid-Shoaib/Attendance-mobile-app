#!/usr/bin/env sh
# Gradle start-up script. Generated by the standard React Native template.
# Run `gradle wrapper` in this directory (with Gradle installed) to
# regenerate the wrapper jar (gradle/wrapper/gradle-wrapper.jar), which is
# a binary file and therefore not included in this source-only delivery.
DIR="$(cd "$(dirname "$0")" && pwd)"
exec java -jar "$DIR/gradle/wrapper/gradle-wrapper.jar" "$@"
